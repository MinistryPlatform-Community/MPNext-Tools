{
  "name": "mpnext-tools",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^24.15.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "tsx src/lib/providers/ministry-platform/scripts/build-sql-install.ts && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "mp:generate": "tsx src/lib/providers/ministry-platform/scripts/generate-types.ts",
    "mp:generate:models": "tsx src/lib/providers/ministry-platform/scripts/generate-types.ts -o src/lib/providers/ministry-platform/models --zod --clean",
    "mp:generate:storedprocs": "tsx src/lib/providers/ministry-platform/scripts/generate-storedprocs.ts",
    "mp:build:install": "tsx src/lib/providers/ministry-platform/scripts/build-sql-install.ts",
    "setup": "tsx scripts/setup.ts",
    "setup:check": "tsx scripts/setup.ts --check",
    "prepare": "git config core.hooksPath .githooks || exit 0"
  },
  "dependencies": {
    "@dnd-kit/abstract": "^0.5.0",
    "@dnd-kit/helpers": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-alert-dialog": "^1.1.24",
    "@radix-ui/react-avatar": "^1.2.7",
    "@radix-ui/react-checkbox": "^1.3.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-label": "^2.1.16",
    "@radix-ui/react-popover": "^1.2.0",
    "@radix-ui/react-radio-group": "^1.4.8",
    "@radix-ui/react-select": "^2.3.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.3.8",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@react-pdf/renderer": "^4.9.0",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "docx": "^9.9.0",
    "docxtemplater": "^3.71.0",
    "docxtemplater-image": "^0.1.2",
    "dotenv": "^18.0.7",
    "jose": "^6.2.12",
    "lucide-react": "^1.55.0",
    "next": "^16.4.0",
    "pizzip": "^3.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15",
    "vaul": "^1.1.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@inquirer/prompts": "^8.7.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.0",
    "chalk": "^6.0.1",
    "eslint": "~9.39.4",
    "eslint-config-next": "^16.4.0",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.2.0",
    "tw-animate-css": "^1.4.0",
