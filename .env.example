# =============================================================================
# Better Auth Configuration
# =============================================================================
# Better Auth handles user authentication via OAuth against Ministry Platform.
# Docs: https://www.better-auth.com/docs

# Secret used by Better Auth for signing session cookies and tokens.
# Must be at least 32 characters with high entropy.
# Generate one with:  openssl rand -base64 32
# Fallback: NEXTAUTH_SECRET (for migrating from NextAuth)
BETTER_AUTH_SECRET=

# Base URL of this application (used for OAuth callback URLs, etc.)
# Update to match your production environment.
# Fallback: NEXTAUTH_URL (for migrating from NextAuth)
BETTER_AUTH_URL=http://localhost:3000

# =============================================================================
# MinistryPlatform API Configuration
# =============================================================================
# This API Client / Secret will be used for server-side data access and will be
# the user for audit log data when no userId is provided.

MINISTRY_PLATFORM_CLIENT_ID=MPNext
MINISTRY_PLATFORM_CLIENT_SECRET=
MINISTRY_PLATFORM_BASE_URL=https://mpi.ministryplatform.com/ministryplatformapi

# -----------------------------------------------------------------------------
# Development-only MinistryPlatform API credentials
# -----------------------------------------------------------------------------
# DEVELOPMENT ONLY — DO NOT USE IN PRODUCTION.
# These credentials are intended solely for local development and testing
# against a non-production MP environment. They are ignored in production
# builds and must never be deployed to production environments.
#
# Use a separate MP API Client registered against your dev/staging MP instance.
MINISTRY_PLATFORM_DEV_CLIENT_ID=
MINISTRY_PLATFORM_DEV_CLIENT_SECRET=

# =============================================================================
# Google Places (optional)
# =============================================================================
# Enables address autocomplete on the Address Line 1 field in the Add/Edit
# Family tool (and any other tool that uses GooglePlacesService).
#
# Key resolution order (first non-empty wins):
#   1. MinistryPlatform dp_Configuration_Settings
#      (Application_Code='COMMON', Key_Name='GoogleMapsAPIKey')
#   2. This GOOGLE_PLACES_API_KEY environment variable
#   3. If neither is set, the feature is disabled — the tool falls back to
#      a plain text input with no errors and no UI change beyond losing the
#      suggestion dropdown.
#
# Get a key at https://console.cloud.google.com and enable the "Places API
# (New)" — the v1 REST endpoints. Calls go through our server actions, so
# restrict the key by IP / service in Google Cloud Console rather than by
# HTTP referrer.
GOOGLE_PLACES_API_KEY=

# =============================================================================
# NEXT Public Keys
# =============================================================================
NEXT_PUBLIC_MINISTRY_PLATFORM_FILE_URL=https://mpi.ministryplatform.com/ministryplatformapi/files
NEXT_PUBLIC_APP_NAME=MPNextApp

# Production URL for this app. Used by the Your Authorized Tools debug panel to
# construct the full production URL of the current tool (NEXT_PUBLIC_PROD_URL + pathname)
# and check it against the authorized tool paths returned from Ministry Platform.
NEXT_PUBLIC_PROD_URL=

# --- Security ---

# Comma-separated Ministry Platform security role names permitted to use the
# MP-data tools (READS as well as writes). Blank or unset means "any MP
# security role will do" — a signed-in user with NO role is still refused.
#
# Sign-in itself is deliberately NOT role-gated: a role-less user gets a
# session, the app shell and a working sign-out, and is redirected from the
# tools to /no-access. Refusing at sign-in would strand them with no way out.
MP_SECURITY_ROLES=

# Content Security Policy. ENFORCES by default — only the exact string "false"
# drops to report-only, so a typo fails loud (too-strict header) rather than
# silent (no policy). Set to "false" only to diagnose a violation.
CSP_ENFORCE=

# =============================================================================
# Messaging settings (shared by messaging tools and the collision check)
# =============================================================================
# Pricing used by the messaging tools (USD). Per-segment SMS cost comes from
# dp_SMS_Numbers.Cost_Per_Segment when set; this is the fallback.
# MP Key_Names: MessagingSmsCostPerSegment, MessagingMmsCostPerMessage
TEXT_SMS_COST_PER_SEGMENT=0.0083
TEXT_MMS_COST_PER_MESSAGE=0.022

# Text segments the MP messaging worker delivers per second, for the delivery time
# estimate and the collision check. MP Key_Name: MessagingTextSegmentsPerSecond
TEXT_SEGMENTS_PER_SECOND=5


# --- Messaging settings (shared by messaging tools) ---------------------------
# Every value in this block, plus TEXT_SMS_COST_PER_SEGMENT, TEXT_MMS_COST_PER_MESSAGE
# and TEXT_SEGMENTS_PER_SECOND above, is read first from MinistryPlatform
# dp_Configuration_Settings (Application_Code = MPNEXT, seeded by the install
# script in _INSTALL/), then from the environment variable, then a built-in
# default. Churches should tune them in MP (Administration > Configuration
# Settings); the variables here are only a fallback for installs without the rows.
#
# Collision check: before a send, the tool lists other email/text communications
# starting within a few hours of the planned time. A communication to more than
# the threshold below is a "large send" and is always reported; a planned send over
# the threshold also scans anything still scheduled in the window.
# MP Key_Name: MessagingLargeSendThreshold
MESSAGING_COLLISION_LARGE_SEND_THRESHOLD=1000
# MP Key_Names: MessagingCollisionLookbackHours, MessagingCollisionLookaheadHours
MESSAGING_COLLISION_LOOKBACK_HOURS=12
MESSAGING_COLLISION_LOOKAHEAD_HOURS=12
# Within this many hours either side, messages share the delivery queue and are
# flagged; sends to more than the high-impact count get a "High impact" badge.
# MP Key_Names: MessagingCollisionCriticalHours, MessagingHighImpactThreshold
MESSAGING_COLLISION_CRITICAL_HOURS=2
MESSAGING_COLLISION_HIGH_IMPACT_THRESHOLD=10000
# The MP messaging worker is one serial queue shared by email and text; emails
# process at about this many per second (texts use TEXT_SEGMENTS_PER_SECOND).
# MP Key_Name: MessagingEmailsPerSecond
MESSAGING_COLLISION_EMAILS_PER_SECOND=5

# =============================================================================
# Text Messaging tool
# =============================================================================
# The tool writes dp_Communications + dp_Communication_Messages rows directly and
# lets the platform's communication service deliver them. All values below have
# defaults matching a stock MP install; set them only if your instance differs.
#
# dp_Communication_Statuses: the communication is created as Draft, filled with
# message rows, then moved to Ready to Send when the recipient count is within
# the sender's pre-approved dp_Roles.Mass_Text_Quota, or to In Review otherwise.
MP_COMMUNICATION_STATUS_DRAFT_ID=1
MP_COMMUNICATION_STATUS_IN_REVIEW_ID=2
MP_COMMUNICATION_STATUS_READY_ID=3
# Sent = 4. The collision check skips Drafts entirely and leaves Sent emails out of
# its delivery-queue estimate (Sent texts stay in, since the carrier may still be
# working through them).
MP_COMMUNICATION_STATUS_SENT_ID=4

# dp_Communication_Action_Statuses row the platform treats as "still to send" (Ready to Send = 2).
MP_MESSAGE_ACTION_STATUS_READY_ID=2

# dp_Communication_Types fallback for texts. Normally resolved by name from the
# readable dp_Communication_Types table; this is only used if that lookup fails.
MP_COMMUNICATION_TYPE_TEXT_ID=2

# Attached images are resized client-side so their width is at most this.
NEXT_PUBLIC_TEXT_IMAGE_MAX_WIDTH=1200

# AI rewrite: the button stays hidden until a provider is wired in
# src/lib/providers/ai-text/index.ts. No environment variables are read for it here;
# your provider implementation defines its own.
