# =============================================================================
# Better Auth Configuration
# =============================================================================
# Better Auth handles user authentication via OAuth against Ministry Platform.
# Docs: https://www.better-auth.com/docs

# Secret used by Better Auth to sign and encrypt session cookies.
# REQUIRED. The app REFUSES TO START (including `next build`) when it is unset,
# shorter than 32 characters, or better-auth's public default secret — a known
# secret lets anyone forge a session for any user.
# Generate one with:  openssl rand -base64 32
# Rotating it signs every user out once and invalidates any forged cookie.
# Do NOT set BETTER_AUTH_SECRETS (versioned secrets): it would silently take
# precedence over this value, so the app refuses to start when it is set.
# Fallback: NEXTAUTH_SECRET (for migrating from NextAuth)
BETTER_AUTH_SECRET=

# Base URL of this application (used for OAuth callback URLs, etc.)
# Update to match your production environment. REQUIRED and validated at start:
# an ORIGIN only (no path), https:// for every real host (http:// is accepted
# only for localhost / 127.0.0.1 / [::1]), no credentials, query or fragment.
# Fallback: NEXTAUTH_URL (for migrating from NextAuth)
BETTER_AUTH_URL=http://localhost:3000

# =============================================================================
# MinistryPlatform API Configuration
# =============================================================================
# This API Client / Secret will be used for server-side data access and will be
# the user for audit log data when no userId is provided.

MINISTRY_PLATFORM_CLIENT_ID=MPNext
MINISTRY_PLATFORM_CLIENT_SECRET=
# Validated at start: https:// (http://localhost only outside production),
# no credentials, query or fragment. A trailing slash is stripped.
MINISTRY_PLATFORM_BASE_URL=https://mpi.ministryplatform.com/ministryplatformapi

# -----------------------------------------------------------------------------
# Development-only MinistryPlatform API credentials
# -----------------------------------------------------------------------------
# DEVELOPMENT ONLY — DO NOT USE IN PRODUCTION.
# These credentials are intended solely for local development and testing
# against a non-production MP environment. They are ignored in production
# builds and must never be deployed to production environments.
#
# Use a separate MP API Client registered against your dev/staging MP instance.
MINISTRY_PLATFORM_DEV_CLIENT_ID=
MINISTRY_PLATFORM_DEV_CLIENT_SECRET=

# =============================================================================
# Google Places (optional)
# =============================================================================
# Enables address autocomplete on the Address Line 1 field in the Add/Edit
# Family tool (and any other tool that uses GooglePlacesService).
#
# Key resolution order (first non-empty wins):
#   1. MinistryPlatform dp_Configuration_Settings
#      (Application_Code='COMMON', Key_Name='GoogleMapsAPIKey')
#   2. This GOOGLE_PLACES_API_KEY environment variable
#   3. If neither is set, the feature is disabled — the tool falls back to
#      a plain text input with no errors and no UI change beyond losing the
#      suggestion dropdown.
#
# Get a key at https://console.cloud.google.com and enable the "Places API
# (New)" — the v1 REST endpoints. Calls go through our server actions, so
# restrict the key by IP / service in Google Cloud Console rather than by
# HTTP referrer.
GOOGLE_PLACES_API_KEY=

# =============================================================================
# NEXT Public Keys
# =============================================================================
NEXT_PUBLIC_MINISTRY_PLATFORM_FILE_URL=https://mpi.ministryplatform.com/ministryplatformapi/files
NEXT_PUBLIC_APP_NAME=MPNextApp

# Production URL for this app. Used by the Your Authorized Tools debug panel to
# construct the full production URL of the current tool (NEXT_PUBLIC_PROD_URL + pathname)
# and check it against the authorized tool paths returned from Ministry Platform.
NEXT_PUBLIC_PROD_URL=

# --- Security ---

# Which Ministry Platform security roles may use the MP-data tools (READS as
# well as writes). This app reads MP with its own service account, so MP's
# per-user record security never applies to what it returns — this variable is
# the control that decides who gets that access. It FAILS CLOSED:
#
#   *                          any MP security role will do (a signed-in user
#                              with NO role is still refused)
#   Administrators,Staff       only users holding one of these roles
#                              (comma-separated, case-insensitive)
#   unset / blank / ","        NOBODY — every user is sent to /no-access
#
# `*` is a wildcard only as the whole value; inside a list it is just a name.
# Roles are matched by NAME, so restrict who can create/rename Security Roles
# in MP. Replace `*` with specific role names once you know who needs access.
#
# Sign-in itself is deliberately NOT role-gated: a role-less user gets a
# session, the app shell and a working sign-out, and is redirected from the
# tools to /no-access. Refusing at sign-in would strand them with no way out.
MP_SECURITY_ROLES=*

# Content Security Policy. ENFORCES by default — only the exact string "false"
# drops to report-only, so a typo fails loud (too-strict header) rather than
# silent (no policy). Set to "false" only to diagnose a violation.
CSP_ENFORCE=

# Client IP for sign-in rate limiting (comma-separated header names, tried in
# order). Name ONLY a header your edge always OVERWRITES — a header clients can
# set themselves lets them dodge the limit or lock someone else out. Never use a
# raw, client-appendable X-Forwarded-For chain here. Invalid names refuse startup.
#
#   unset, on Vercel     x-vercel-forwarded-for,x-real-ip   (the default: Vercel's
#                        edge sets both to the client IP and drops client values)
#   unset, elsewhere     better-auth's default: a single-value X-Forwarded-For
#   Cloudflare           cf-connecting-ip
#   Azure Front Door     x-azure-clientip
#   Azure App Service    x-client-ip
#   nginx / other proxy  the header it SETS (e.g. x-real-ip with
#                        `proxy_set_header X-Real-IP $remote_addr;`)
#   Vercel behind Cloudflare  cf-connecting-ip (and lock the origin to Cloudflare)
AUTH_IP_ADDRESS_HEADERS=

# For a proxy that APPENDS to X-Forwarded-For instead: comma-separated proxy IPs
# or CIDR ranges. The chain is walked right to left past these; the first
# untrusted hop is the client. Invalid entries refuse startup.
AUTH_TRUSTED_PROXIES=
